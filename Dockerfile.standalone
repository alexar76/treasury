# Standalone image for the GitHub mirror (oracle-core + momus vendored at publish time).
# Build from the satellite repo root:
#   docker build -f Dockerfile.standalone -t ghcr.io/alexar76/treasury .
FROM python:3.11-slim
WORKDIR /app

COPY vendor/oracle-core /app/oracle-core
COPY vendor/momus /app/momus
COPY . /app/treasury

RUN pip install --no-cache-dir -e "/app/oracle-core[pqc]" -e /app/momus -e /app/treasury

EXPOSE 9401
CMD ["python", "-m", "treasury.service"]
